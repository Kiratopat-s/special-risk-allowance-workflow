// Prisma Schema - Clean Architecture Domain Models
// Learn more: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// =============================================================================
// ENUMS
// =============================================================================

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  PENDING
}

enum ActionType {
  // Authentication
  LOGIN
  LOGOUT
  LOGIN_FAILED
  SESSION_REFRESH

  // User Management
  USER_CREATED
  USER_UPDATED
  USER_DELETED
  USER_STATUS_CHANGED

  // Profile Management
  PROFILE_VIEWED
  PROFILE_UPDATED
  PASSWORD_CHANGED

  // Department Management
  DEPARTMENT_CREATED
  DEPARTMENT_UPDATED
  DEPARTMENT_DELETED

  // System Actions
  SYSTEM_ACCESS
  PERMISSION_GRANTED
  PERMISSION_REVOKED

  // Data Operations
  DATA_EXPORTED
  DATA_IMPORTED

  // Claim workflow
  CLAIM_DRAFT_SAVED
  CLAIM_SUBMITTED
  CLAIM_CORRECTION_STARTED
  CLAIM_RESUBMITTED
  CLAIM_CANCELLED
  CLAIM_REJECTED
  CLAIM_COLLECTED
  CLAIM_REMOVED_FROM_COLLECTION
  CLAIM_SUSPICIOUS_MARKED
  CLAIM_SUSPICIOUS_RESOLVED
  LEADER_VERIFICATION_CONFIRMED

  // Monthly request workflow
  MRC_FINALIZED
  MRC_ALL_DONE_RECORDED
  MRC_DRAFT_CANCELLED
  MRC_VOIDED
  MRC_PREVIEW_RENDERED
  MRC_OFFICIAL_RENDERED

  // Other
  OTHER
}

// =============================================================================
// DOMAIN: USER
// =============================================================================

model User {
  id         String @id @default(uuid())
  keycloakId String @unique @map("keycloak_id")

  // Personal Information
  email       String  @unique
  peaEmail    String? @map("pea_email")
  firstName   String  @map("first_name")
  lastName    String  @map("last_name")
  phoneNumber String? @map("phone_number")
  employeeId  String? @unique @map("employee_id")

  // Position Information
  position      String?
  positionShort String? @map("position_short")
  positionLevel String? @map("position_level")

  // Department Relation
  departmentId String?     @map("department_id")
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  // Status & Metadata
  status      UserStatus @default(ACTIVE)
  lastLoginAt DateTime?  @map("last_login_at") @db.Timestamptz(3)
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  // Relations
  actionLogs                 UserActionLog[]                @relation("UserActions")
  targetedActions            UserActionLog[]                @relation("TargetUserActions")
  userRoles                  UserRole[]
  files                      Files[]
  offSiteWorks               OffSiteWork[]
  offSiteWorkParticipants    OffSiteWorkParticipant[]
  expenseClaims              ExpenseClaim[]                 @relation("ExpenseClaimUser")
  createdExpenseClaims       ExpenseClaim[]                 @relation("ExpenseClaimCreator")
  rejectedExpenseClaims      ExpenseClaim[]                 @relation("ExpenseClaimRejectedBy")
  collectedMonthlyRequests   MonthlyRequestCollection[]     @relation("MrcCollector")
  finalizedMonthlyRequests   MonthlyRequestCollection[]     @relation("MrcFinalizedBy")
  completedMonthlyRequests   MonthlyRequestCollection[]     @relation("MrcCompletedBy")
  cancelledMonthlyRequests   MonthlyRequestCollection[]     @relation("MrcCancelledBy")
  voidedMonthlyRequests      MonthlyRequestCollection[]     @relation("MrcVoidedBy")
  openedClaimReviewFlags     ClaimReviewFlag[]              @relation("ClaimReviewFlagOpenedBy")
  resolvedClaimReviewFlags   ClaimReviewFlag[]              @relation("ClaimReviewFlagResolvedBy")
  addedMonthlyRequestItems   MonthlyRequestCollectionItem[] @relation("MrcItemAddedBy")
  removedMonthlyRequestItems MonthlyRequestCollectionItem[] @relation("MrcItemRemovedBy")
  signatures                 Signature[]
  notifications              Notification[]
  pushSubscriptions          PushSubscription[]
  ledOSWs                    OffSiteWork[]                  @relation("OffSiteWorkLeader")
  leaderVerifications        LeaderVerification[]           @relation("LeaderVerificationUser")

  @@index([keycloakId])
  @@index([email])
  @@index([departmentId])
  @@index([status])
  @@index([lastLoginAt])
  @@index([employeeId])
  @@map("users")
}

// =============================================================================
// DOMAIN: DEPARTMENT
// =============================================================================

model Department {
  id String @id @default(uuid())

  // Department Information
  name        String  @unique
  shortName   String? @unique @map("short_name")
  description String?

  // Hierarchy (self-referencing for organizational structure)
  parentId String?      @map("parent_id")
  parent   Department?  @relation("DepartmentHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children Department[] @relation("DepartmentHierarchy")

  // Status & Metadata
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  // Relations
  users           User[]
  actionLogs      UserActionLog[]
  userRoles       UserRole[]
  monthlyRequests MonthlyRequestCollection[]

  @@index([name])
  @@index([shortName])
  @@index([parentId])
  @@map("departments")
}

// =============================================================================
// DOMAIN: USER ACTION LOG (Audit Trail)
// =============================================================================

model UserActionLog {
  id String @id @default(uuid())

  // Actor Information
  userId String @map("user_id")
  user   User   @relation("UserActions", fields: [userId], references: [id], onDelete: Restrict)

  // Action Details
  actionType        ActionType @map("action_type")
  actionDescription String?    @map("action_description")

  // Target Entity (optional - for actions on other entities)
  targetUserId String? @map("target_user_id")
  targetUser   User?   @relation("TargetUserActions", fields: [targetUserId], references: [id], onDelete: SetNull)

  targetDepartmentId String?     @map("target_department_id")
  targetDepartment   Department? @relation(fields: [targetDepartmentId], references: [id], onDelete: SetNull)

  // Generic target for other entities
  targetEntityType String? @map("target_entity_type")
  targetEntityId   String? @map("target_entity_id")

  // Request Context
  ipAddress     String? @map("ip_address")
  userAgent     String? @map("user_agent")
  requestPath   String? @map("request_path")
  requestMethod String? @map("request_method")

  // Additional Data (JSON for flexibility)
  metadata     Json?
  previousData Json? @map("previous_data")
  newData      Json? @map("new_data")

  // Status
  isSuccess    Boolean @default(true) @map("is_success")
  errorMessage String? @map("error_message")

  // Timestamp
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([userId])
  @@index([actionType])
  @@index([targetUserId])
  @@index([targetDepartmentId])
  @@index([createdAt])
  @@index([isSuccess])
  @@index([targetEntityType, targetEntityId, createdAt])
  @@map("user_action_logs")
}

model OffSiteWork {
  id                 String    @id
  innerRefDocumentId String?   @map("inner_ref_document_id")
  startDate          DateTime  @map("start_date") @db.Date
  endDate            DateTime  @map("end_date") @db.Date
  objective          String?
  location           String?
  postedAt           DateTime  @default(now()) @map("posted_at") @db.Timestamptz(3)
  postedByUserId     String    @map("posted_by_user_id")
  postedByUser       User      @relation(fields: [postedByUserId], references: [id], onDelete: Restrict)
  updatedAt          DateTime? @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt          DateTime? @map("deleted_at") @db.Timestamptz(3)
  lockedAt           DateTime? @map("locked_at") @db.Timestamptz(3)
  originalFileId     String?   @map("original_file_id")

  supersedesId String?       @map("supersedes_id")
  supersedes   OffSiteWork?  @relation("OffSiteWorkReplacement", fields: [supersedesId], references: [id], onDelete: SetNull)
  replacements OffSiteWork[] @relation("OffSiteWorkReplacement")

  // Optional leader — internal (system user) or external (manual info)
  leaderUserId    String? @map("leader_user_id")
  leaderUser      User?   @relation("OffSiteWorkLeader", fields: [leaderUserId], references: [id], onDelete: SetNull)
  leaderEmpId     String? @map("leader_emp_id")
  leaderFirstName String? @map("leader_first_name")
  leaderLastName  String? @map("leader_last_name")
  leaderPosition  String? @map("leader_position")
  leaderEmail     String? @map("leader_email")

  originalFile      Files?                            @relation(fields: [originalFileId], references: [id], onDelete: SetNull)
  participants      OffSiteWorkParticipant[]
  revisionSnapshots ExpenseClaimRevisionOffSiteWork[]

  @@index([postedByUserId])
  @@index([originalFileId])
  @@index([startDate])
  @@index([endDate])
  @@index([deletedAt])
  @@index([postedAt])
  @@index([leaderUserId])
  @@index([supersedesId])
  @@map("off_site_works")
}

model OffSiteWorkParticipant {
  offSiteWorkId          String      @map("off_site_work_id")
  offSiteWork            OffSiteWork @relation(fields: [offSiteWorkId], references: [id], onDelete: Cascade)
  userId                 String      @map("user_id")
  user                   User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  employeeIdSnapshot     String?     @map("employee_id_snapshot")
  firstNameSnapshot      String      @map("first_name_snapshot")
  lastNameSnapshot       String      @map("last_name_snapshot")
  positionSnapshot       String?     @map("position_snapshot")
  positionShortSnapshot  String?     @map("position_short_snapshot")
  positionLevelSnapshot  String?     @map("position_level_snapshot")
  departmentIdSnapshot   String?     @map("department_id_snapshot")
  departmentNameSnapshot String?     @map("department_name_snapshot")
  createdAt              DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)

  @@id([offSiteWorkId, userId])
  @@index([userId])
  @@index([departmentIdSnapshot])
  @@map("off_site_work_participants")
}

model Files {
  id           String    @id @default(uuid())
  fileName     String    @map("file_name")
  fileType     String?   @map("file_type")
  fileSize     Int?      @map("file_size")
  fileContent  Bytes?    @map("file_content")
  uploadedById String    @map("uploaded_by_id")
  uploadedBy   User      @relation(fields: [uploadedById], references: [id], onDelete: Restrict)
  uploadedAt   DateTime? @default(now()) @map("uploaded_at") @db.Timestamptz(3)
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz(3)

  offSiteWorks OffSiteWork[]

  @@index([uploadedById])
  @@index([deletedAt])
  @@index([uploadedAt])
  @@map("files")
}

enum ExpenseClaimStatus {
  DRAFT
  PENDING_LEADER_CONFIRMATION
  READY_FOR_COLLECTION
  COLLECTED
  COMPLETED
  REJECTED
  CANCELLED
}

enum ExpenseClaimRevisionStatus {
  DRAFT
  SUBMITTED
  SUPERSEDED
}

enum WorkDayType {
  DUTY
  TRAVEL
}

enum HolidayType {
  WORKDAY
  WEEKEND
  PUBLIC_HOLIDAY
  FALLBACK_WORKDAY
}

enum HolidaySource {
  GOOGLE
  CALCULATED
  MANUAL
  FALLBACK
}

enum HolidaySyncStatus {
  PENDING
  SUCCESS
  FAILED
}

model ExpenseClaim {
  id                String             @id @default(uuid())
  expenseMonth      DateTime           @map("expense_month") @db.Date
  userId            String             @map("user_id")
  claimant          User               @relation("ExpenseClaimUser", fields: [userId], references: [id], onDelete: Restrict)
  createdById       String             @map("created_by_id")
  createdBy         User               @relation("ExpenseClaimCreator", fields: [createdById], references: [id], onDelete: Restrict)
  status            ExpenseClaimStatus @default(DRAFT)
  currentRevisionNo Int                @default(1) @map("current_revision_no")
  collectedAt       DateTime?          @map("collected_at") @db.Timestamptz(3)
  completedAt       DateTime?          @map("completed_at") @db.Timestamptz(3)
  rejectedAt        DateTime?          @map("rejected_at") @db.Timestamptz(3)
  rejectedById      String?            @map("rejected_by_id")
  rejectedBy        User?              @relation("ExpenseClaimRejectedBy", fields: [rejectedById], references: [id], onDelete: SetNull)
  rejectionReason   String?            @map("rejection_reason")
  cancelledAt       DateTime?          @map("cancelled_at") @db.Timestamptz(3)
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  revisions           ExpenseClaimRevision[]
  reviewFlags         ClaimReviewFlag[]
  monthlyRequestItems MonthlyRequestCollectionItem[]

  @@index([userId])
  @@index([createdById])
  @@index([expenseMonth])
  @@index([status])
  @@index([createdAt])
  @@index([userId, expenseMonth])
  @@index([status, expenseMonth])
  @@map("expense_claims")
}

model ExpenseClaimRevision {
  id                      String                     @id @default(uuid())
  expenseClaimId          String                     @map("expense_claim_id")
  expenseClaim            ExpenseClaim               @relation(fields: [expenseClaimId], references: [id], onDelete: Cascade)
  revisionNo              Int                        @map("revision_no")
  status                  ExpenseClaimRevisionStatus @default(DRAFT)
  employeeIdSnapshot      String                     @map("employee_id_snapshot")
  firstNameSnapshot       String                     @map("first_name_snapshot")
  lastNameSnapshot        String                     @map("last_name_snapshot")
  positionSnapshot        String?                    @map("position_snapshot")
  positionShortSnapshot   String                     @map("position_short_snapshot")
  positionLevelSnapshot   String?                    @map("position_level_snapshot")
  departmentIdSnapshot    String                     @map("department_id_snapshot")
  departmentNameSnapshot  String                     @map("department_name_snapshot")
  departmentShortSnapshot String?                    @map("department_short_snapshot")
  ratePerDay              Decimal                    @default(150) @map("rate_per_day") @db.Decimal(12, 2)
  totalDays               Int                        @default(0) @map("total_days")
  totalAmount             Decimal                    @default(0) @map("total_amount") @db.Decimal(12, 2)
  remark                  String?
  materialHash            String?                    @map("material_hash") @db.Char(64)
  submittedAt             DateTime?                  @map("submitted_at") @db.Timestamptz(3)
  supersededAt            DateTime?                  @map("superseded_at") @db.Timestamptz(3)
  createdAt               DateTime                   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt               DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(3)

  offSiteWorks        ExpenseClaimRevisionOffSiteWork[]
  workDates           ExpenseClaimWorkDate[]
  leaderVerifications LeaderVerification[]
  monthlyRequestItems MonthlyRequestCollectionItem[]

  @@unique([expenseClaimId, revisionNo])
  @@index([expenseClaimId, status])
  @@index([departmentIdSnapshot])
  @@map("expense_claim_revisions")
}

model ExpenseClaimRevisionOffSiteWork {
  id                         String               @id @default(uuid())
  revisionId                 String               @map("revision_id")
  revision                   ExpenseClaimRevision @relation(fields: [revisionId], references: [id], onDelete: Cascade)
  offSiteWorkId              String               @map("off_site_work_id")
  offSiteWork                OffSiteWork          @relation(fields: [offSiteWorkId], references: [id], onDelete: Restrict)
  innerRefDocumentIdSnapshot String?              @map("inner_ref_document_id_snapshot")
  startDateSnapshot          DateTime             @map("start_date_snapshot") @db.Date
  endDateSnapshot            DateTime             @map("end_date_snapshot") @db.Date
  objectiveSnapshot          String?              @map("objective_snapshot")
  locationSnapshot           String?              @map("location_snapshot")
  leaderUserIdSnapshot       String?              @map("leader_user_id_snapshot")
  leaderEmpIdSnapshot        String?              @map("leader_emp_id_snapshot")
  leaderFirstNameSnapshot    String               @map("leader_first_name_snapshot")
  leaderLastNameSnapshot     String               @map("leader_last_name_snapshot")
  leaderPositionSnapshot     String?              @map("leader_position_snapshot")
  leaderEmailSnapshot        String?              @map("leader_email_snapshot")
  createdAt                  DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)

  workDates          ExpenseClaimWorkDate[]
  leaderVerification LeaderVerification?

  @@unique([revisionId, offSiteWorkId])
  @@index([offSiteWorkId])
  @@index([revisionId])
  @@map("expense_claim_revision_off_site_works")
}

model ExpenseClaimWorkDate {
  id                    String                           @id @default(uuid())
  revisionId            String                           @map("revision_id")
  revision              ExpenseClaimRevision             @relation(fields: [revisionId], references: [id], onDelete: Cascade)
  revisionOffSiteWorkId String                           @map("revision_off_site_work_id")
  revisionOffSiteWork   ExpenseClaimRevisionOffSiteWork  @relation(fields: [revisionOffSiteWorkId], references: [id], onDelete: Cascade)
  workDate              DateTime                         @map("work_date") @db.Date
  dayType               WorkDayType                      @map("day_type")
  holidayType           HolidayType                      @map("holiday_type")
  holidayName           String?                          @map("holiday_name")
  holidaySource         HolidaySource                    @map("holiday_source")
  requiresWeSafe        Boolean                          @default(false) @map("requires_we_safe")
  dailyRate             Decimal                          @default(150) @map("daily_rate") @db.Decimal(12, 2)
  createdAt             DateTime                         @default(now()) @map("created_at") @db.Timestamptz(3)
  weSafeCodes           ExpenseClaimWorkDateWeSafeCode[]

  @@unique([revisionId, workDate])
  @@index([revisionOffSiteWorkId, workDate])
  @@index([workDate])
  @@map("expense_claim_work_dates")
}

model ExpenseClaimWorkDateWeSafeCode {
  id         String               @id @default(uuid())
  workDateId String               @map("work_date_id")
  workDate   ExpenseClaimWorkDate @relation(fields: [workDateId], references: [id], onDelete: Cascade)
  code       String
  createdAt  DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([workDateId])
  @@map("expense_claim_work_date_we_safe_codes")
}

model HolidayCalendarDate {
  date            DateTime      @id @db.Date
  name            String
  source          HolidaySource
  sourceReference String?       @map("source_reference")
  fetchedAt       DateTime      @default(now()) @map("fetched_at") @db.Timestamptz(3)

  @@index([source])
  @@map("holiday_calendar_dates")
}

model HolidayCalendarSync {
  id            String            @id @default(uuid())
  year          Int
  provider      HolidaySource
  status        HolidaySyncStatus
  lastAttemptAt DateTime          @default(now()) @map("last_attempt_at") @db.Timestamptz(3)
  lastSuccessAt DateTime?         @map("last_success_at") @db.Timestamptz(3)
  errorMessage  String?           @map("error_message")

  @@unique([year, provider])
  @@map("holiday_calendar_syncs")
}

enum ClaimReviewFlagStatus {
  OPEN
  RESOLVED
}

model ClaimReviewFlag {
  id             String                @id @default(uuid())
  expenseClaimId String                @map("expense_claim_id")
  expenseClaim   ExpenseClaim          @relation(fields: [expenseClaimId], references: [id], onDelete: Restrict)
  status         ClaimReviewFlagStatus @default(OPEN)
  note           String
  openedById     String                @map("opened_by_id")
  openedBy       User                  @relation("ClaimReviewFlagOpenedBy", fields: [openedById], references: [id], onDelete: Restrict)
  openedAt       DateTime              @default(now()) @map("opened_at") @db.Timestamptz(3)
  resolutionNote String?               @map("resolution_note")
  resolvedById   String?               @map("resolved_by_id")
  resolvedBy     User?                 @relation("ClaimReviewFlagResolvedBy", fields: [resolvedById], references: [id], onDelete: Restrict)
  resolvedAt     DateTime?             @map("resolved_at") @db.Timestamptz(3)

  @@index([expenseClaimId, status])
  @@index([openedById])
  @@map("claim_review_flags")
}

enum MonthlyRequestStatus {
  DRAFT
  FINALIZED
  ALL_DONE
  CANCELLED
  VOIDED
}

model MonthlyRequestCollection {
  id              String               @id @default(uuid())
  departmentId    String               @map("department_id")
  department      Department           @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  collectorId     String               @map("collector_id")
  collector       User                 @relation("MrcCollector", fields: [collectorId], references: [id], onDelete: Restrict)
  collectForMonth DateTime             @map("collect_for_month") @db.Date
  batchNo         Int?                 @map("batch_no")
  status          MonthlyRequestStatus @default(DRAFT)
  claimCount      Int                  @default(0) @map("claim_count")
  countDates      Int                  @default(0) @map("count_dates")
  amount          Decimal              @default(0) @db.Decimal(12, 2)
  snapshotVersion Int                  @default(1) @map("snapshot_version")
  snapshotHash    String?              @map("snapshot_hash") @db.Char(64)
  finalizedAt     DateTime?            @map("finalized_at") @db.Timestamptz(3)
  finalizedById   String?              @map("finalized_by_id")
  finalizedBy     User?                @relation("MrcFinalizedBy", fields: [finalizedById], references: [id], onDelete: Restrict)
  paperApprovedAt DateTime?            @map("paper_approved_at") @db.Timestamptz(3)
  allDoneNote     String?              @map("all_done_note")
  allDoneAt       DateTime?            @map("all_done_at") @db.Timestamptz(3)
  allDoneById     String?              @map("all_done_by_id")
  allDoneBy       User?                @relation("MrcCompletedBy", fields: [allDoneById], references: [id], onDelete: Restrict)
  cancelledAt     DateTime?            @map("cancelled_at") @db.Timestamptz(3)
  cancelledById   String?              @map("cancelled_by_id")
  cancelledBy     User?                @relation("MrcCancelledBy", fields: [cancelledById], references: [id], onDelete: Restrict)
  cancelReason    String?              @map("cancel_reason")
  voidedAt        DateTime?            @map("voided_at") @db.Timestamptz(3)
  voidedById      String?              @map("voided_by_id")
  voidedBy        User?                @relation("MrcVoidedBy", fields: [voidedById], references: [id], onDelete: Restrict)
  voidReason      String?              @map("void_reason")
  createdAt       DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)

  items              MonthlyRequestCollectionItem[]
  replacementSources MrcReplacementSource[]         @relation("MrcReplacementDraft")
  replacementDrafts  MrcReplacementSource[]         @relation("MrcVoidedSource")

  @@unique([departmentId, collectForMonth, batchNo])
  @@index([collectorId])
  @@index([departmentId])
  @@index([collectForMonth])
  @@index([status])
  @@index([createdAt])
  @@index([departmentId, collectForMonth, status])
  @@map("monthly_request_collections")
}

model MonthlyRequestCollectionItem {
  id                         String                   @id @default(uuid())
  monthlyRequestCollectionId String                   @map("monthly_request_collection_id")
  monthlyRequestCollection   MonthlyRequestCollection @relation(fields: [monthlyRequestCollectionId], references: [id], onDelete: Restrict)
  expenseClaimId             String                   @map("expense_claim_id")
  expenseClaim               ExpenseClaim             @relation(fields: [expenseClaimId], references: [id], onDelete: Restrict)
  claimRevisionId            String                   @map("claim_revision_id")
  claimRevision              ExpenseClaimRevision     @relation(fields: [claimRevisionId], references: [id], onDelete: Restrict)
  addedById                  String                   @map("added_by_id")
  addedBy                    User                     @relation("MrcItemAddedBy", fields: [addedById], references: [id], onDelete: Restrict)
  addedAt                    DateTime                 @default(now()) @map("added_at") @db.Timestamptz(3)
  removedById                String?                  @map("removed_by_id")
  removedBy                  User?                    @relation("MrcItemRemovedBy", fields: [removedById], references: [id], onDelete: Restrict)
  removedAt                  DateTime?                @map("removed_at") @db.Timestamptz(3)
  removalReason              String?                  @map("removal_reason")
  rowNo                      Int?                     @map("row_no")
  employeeIdSnapshot         String?                  @map("employee_id_snapshot")
  firstNameSnapshot          String?                  @map("first_name_snapshot")
  lastNameSnapshot           String?                  @map("last_name_snapshot")
  positionShortSnapshot      String?                  @map("position_short_snapshot")
  positionLevelSnapshot      String?                  @map("position_level_snapshot")
  departmentIdSnapshot       String?                  @map("department_id_snapshot")
  departmentNameSnapshot     String?                  @map("department_name_snapshot")
  departmentShortSnapshot    String?                  @map("department_short_snapshot")
  dayCountSnapshot           Int?                     @map("day_count_snapshot")
  amountSnapshot             Decimal?                 @map("amount_snapshot") @db.Decimal(12, 2)
  remarkSnapshot             String?                  @map("remark_snapshot")
  createdAt                  DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)

  dates MonthlyRequestItemDate[]

  @@unique([monthlyRequestCollectionId, expenseClaimId])
  @@index([expenseClaimId, removedAt])
  @@index([claimRevisionId])
  @@map("monthly_request_collection_items")
}

model MonthlyRequestItemDate {
  id                     String                             @id @default(uuid())
  monthlyRequestItemId   String                             @map("monthly_request_item_id")
  monthlyRequestItem     MonthlyRequestCollectionItem       @relation(fields: [monthlyRequestItemId], references: [id], onDelete: Cascade)
  workDate               DateTime                           @map("work_date") @db.Date
  offSiteWorkIdSnapshot  String                             @map("off_site_work_id_snapshot")
  offSiteWorkRefSnapshot String?                            @map("off_site_work_ref_snapshot")
  dayType                WorkDayType                        @map("day_type")
  holidayType            HolidayType                        @map("holiday_type")
  holidayName            String?                            @map("holiday_name")
  dailyRate              Decimal                            @map("daily_rate") @db.Decimal(12, 2)
  weSafeCodes            MonthlyRequestItemDateWeSafeCode[]

  @@unique([monthlyRequestItemId, workDate])
  @@index([workDate])
  @@map("monthly_request_item_dates")
}

model MonthlyRequestItemDateWeSafeCode {
  id                       String                 @id @default(uuid())
  monthlyRequestItemDateId String                 @map("monthly_request_item_date_id")
  monthlyRequestItemDate   MonthlyRequestItemDate @relation(fields: [monthlyRequestItemDateId], references: [id], onDelete: Cascade)
  code                     String

  @@index([monthlyRequestItemDateId])
  @@map("monthly_request_item_date_we_safe_codes")
}

model MrcReplacementSource {
  replacementDraftId String                   @map("replacement_draft_id")
  replacementDraft   MonthlyRequestCollection @relation("MrcReplacementDraft", fields: [replacementDraftId], references: [id], onDelete: Restrict)
  voidedMrcId        String                   @map("voided_mrc_id")
  voidedMrc          MonthlyRequestCollection @relation("MrcVoidedSource", fields: [voidedMrcId], references: [id], onDelete: Restrict)
  createdAt          DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)

  @@id([replacementDraftId, voidedMrcId])
  @@index([voidedMrcId])
