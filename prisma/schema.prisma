model Signature {
  id            String    @id @default(uuid())
  userId        String    @map("user_id")
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  signatureData Bytes     @map("signature_data") // Binary data for the signature (e.g. image bytes)
  isActive      Boolean   @default(false) @map("is_active")
  activatedAt   DateTime? @map("activated_at") @db.Timestamptz(3)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime? @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz(3)

  @@index([deletedAt])
  @@index([userId, deletedAt])
  @@index([userId, isActive, deletedAt])
  @@map("signatures")
}

// =============================================================================
// DOMAIN: PERMISSION & AUTHORIZATION
// =============================================================================

/// Resource category for organizing permissions
enum PermissionResource {
  // Core resources
  USER
  DEPARTMENT
  ROLE
  PERMISSION

  // Business resources
  EXPENSE_CLAIM
  OFF_SITE_WORK
  MONTHLY_REQUEST
  SIGNATURE
  FILE

  // System resources
  ACTION_LOG
  SYSTEM
}

/// Actions that can be performed on resources
enum PermissionAction {
  CREATE
  READ
  UPDATE
  DELETE
  LIST
  EXPORT
  IMPORT
  APPROVE
  REJECT
  SUBMIT
  CANCEL
  RECHECK
  COLLECT
  REMOVE
  FLAG
  RESOLVE
  FINALIZE
  COMPLETE
  VOID
  PRINT
  MANAGE
}

/// Scope of permission (own items, department items, or all items)
enum PermissionScope {
  OWN // Only own resources (e.g., own expense claims)
  DEPARTMENT // Resources within user's department
  ALL // All resources regardless of ownership
}

/// Permission model - Defines individual permissions
model Permission {
  id String @id @default(uuid())

  // Permission identification
  code        String  @unique // e.g., "expense-claim:create", "user:manage"
  name        String // Human-readable name
  description String? // Detailed description

  // Permission categorization
  resource PermissionResource
  action   PermissionAction
  scope    PermissionScope    @default(OWN)

  // Metadata
  isActive  Boolean  @default(true) @map("is_active")
  isSystem  Boolean  @default(false) @map("is_system") // System permissions cannot be deleted
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  // Relations
  rolePermissions RolePermission[]

  @@index([resource])
  @@index([action])
  @@index([code])
  @@index([isActive])
  @@map("permissions")
}

/// Role model - Defines named roles that group permissions
model Role {
  id String @id @default(uuid())

  // Role identification
  code        String  @unique // e.g., "admin", "manager", "employee"
  name        String // Human-readable name
  description String? // Role description

  // Role hierarchy (optional)
  level        Int     @default(0) // Higher level = more authority
  parentRoleId String? @map("parent_role_id")
  parentRole   Role?   @relation("RoleHierarchy", fields: [parentRoleId], references: [id], onDelete: SetNull)
  childRoles   Role[]  @relation("RoleHierarchy")

  // Metadata
  isActive  Boolean  @default(true) @map("is_active")
  isSystem  Boolean  @default(false) @map("is_system") // System roles cannot be deleted
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  // Relations
  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@index([code])
  @@index([level])
  @@index([isActive])
  @@index([parentRoleId])
  @@map("roles")
}

/// UserRole - Junction table linking users to roles
/// Supports department-scoped role assignments
model UserRole {
  id String @id @default(uuid())

  // User and Role
  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleId String @map("role_id")
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  // Department scope (optional - null means global assignment)
  departmentId String?     @map("department_id")
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  // Assignment metadata
  assignedById String?   @map("assigned_by_id")
  assignedAt   DateTime  @default(now()) @map("assigned_at") @db.Timestamptz(3)
  expiresAt    DateTime? @map("expires_at") @db.Timestamptz(3) // Optional expiration for temporary roles

  // Status
  isActive Boolean @default(true) @map("is_active")

  @@unique([userId, roleId, departmentId])
  @@index([userId])
  @@index([roleId])
  @@index([departmentId])
  @@index([isActive])
  @@index([expiresAt])
  @@map("user_roles")
}

/// RolePermission - Junction table linking roles to permissions
model RolePermission {
  id String @id @default(uuid())

  roleId       String     @map("role_id")
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String     @map("permission_id")
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  // Granted metadata
  grantedById String?  @map("granted_by_id")
  grantedAt   DateTime @default(now()) @map("granted_at") @db.Timestamptz(3)

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
  @@map("role_permissions")
}

// =============================================================================
// DOMAIN: NOTIFICATIONS
// =============================================================================

/// Categorises the business event that produced a notification
enum NotificationType {
  // MRC lifecycle
  MRC_FINALIZED
  MRC_ALL_DONE
  MRC_CANCELLED
  MRC_VOIDED

  // Expense claim lifecycle
  CLAIM_STATUS_CHANGED
  CLAIM_REJECTED

  // Leader verification
  LEADER_VERIFY_REQUEST // Notifies an internal leader that they need to verify an expense claim

  // Off-site work lifecycle
  OFF_SITE_WORK_UPDATED // Notifies the creator when an off-site work record changes

  // System / admin
  SYSTEM_ANNOUNCEMENT // A message broadcast by an administrator to one or more users
}

/// Persisted notification record linked to a single recipient
model Notification {
  id String @id @default(uuid())

  // Recipient
  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Content
  type  NotificationType @map("type")
  title String
  body  String
  link  String? // Optional deep-link (e.g. /monthly-request-collection/abc)

  // Read tracking
  isRead Boolean   @default(false) @map("is_read")
  readAt DateTime? @map("read_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([userId])
  @@index([userId, isRead])
  @@index([createdAt])
  @@map("notifications")
}

/// Stores Web Push API subscriptions on a per-device basis
model PushSubscription {
  id String @id @default(uuid())

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  endpoint  String  @unique // Push service endpoint URL
  p256dh    String  @map("p256dh") // Client public key
  auth      String // Authentication secret
  userAgent String? @map("user_agent")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([userId])
  @@map("push_subscriptions")
}

// =============================================================================
// DOMAIN: LEADER VERIFICATION
// =============================================================================

enum LeaderVerificationStatus {
  PENDING
  CONFIRMED
  SUPERSEDED
}

model LeaderVerification {
  id                      String                          @id @default(uuid())
  claimRevisionId         String                          @map("claim_revision_id")
  claimRevision           ExpenseClaimRevision            @relation(fields: [claimRevisionId], references: [id], onDelete: Restrict)
  revisionOffSiteWorkId   String                          @unique @map("revision_off_site_work_id")
  revisionOffSiteWork     ExpenseClaimRevisionOffSiteWork @relation(fields: [revisionOffSiteWorkId], references: [id], onDelete: Restrict)
  status                  LeaderVerificationStatus        @default(PENDING)
  leaderUserId            String?                         @map("leader_user_id")
  leaderUser              User?                           @relation("LeaderVerificationUser", fields: [leaderUserId], references: [id], onDelete: SetNull)
  leaderEmpIdSnapshot     String?                         @map("leader_emp_id_snapshot")
  leaderFirstNameSnapshot String                          @map("leader_first_name_snapshot")
  leaderLastNameSnapshot  String                          @map("leader_last_name_snapshot")
  leaderPositionSnapshot  String?                         @map("leader_position_snapshot")
  leaderEmailSnapshot     String?                         @map("leader_email_snapshot")
  tokenHash               String                          @unique @map("token_hash") @db.Char(64)
  expiresAt               DateTime                        @map("expires_at") @db.Timestamptz(3)
  payloadSnapshot         Json                            @map("payload_snapshot")
  payloadHash             String                          @map("payload_hash") @db.Char(64)
  confirmedAt             DateTime?                       @map("confirmed_at") @db.Timestamptz(3)
  signatureData           Bytes?                          @map("signature_data")
  supersededAt            DateTime?                       @map("superseded_at") @db.Timestamptz(3)
  createdAt               DateTime                        @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([claimRevisionId])
  @@index([leaderUserId])
  @@index([tokenHash])
  @@index([status, confirmedAt])
  @@map("leader_verifications")
}
