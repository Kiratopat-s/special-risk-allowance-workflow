# Secrets and local configuration
.env*

# Only commit identity is needed for automatic deployment versions.
# Keep Git config, credentials, hooks, index and object history excluded.
.git/**
!.git/HEAD
!.git/packed-refs
!.git/refs
!.git/refs/heads
!.git/refs/heads/**

# Editor files
.gitignore
.DS_Store

# Dependency and build outputs
node_modules
.next
build
coverage
lib/generated/prisma

# Generated analysis and local-only project artifacts
graphify-out
.agents
.codex
certificates
sql-lab

# Documentation is not needed at image build time
README.md
AGENTS.md
docs
