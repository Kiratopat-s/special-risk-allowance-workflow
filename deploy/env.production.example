# Docker Compose settings. The app binds to this port only on 127.0.0.1.
APP_PORT=3000
IMAGE_TAG=latest

# Required application settings
DATABASE_URL="postgresql://user:password@postgres.example.com:5432/sraw?schema=public"
NEXTAUTH_URL="https://sraw.example.com"
AUTH_SECRET="replace-with-a-long-random-secret"
AUTH_KEYCLOAK_ID="keycloak-client-id"
AUTH_KEYCLOAK_SECRET="keycloak-client-secret"
AUTH_KEYCLOAK_ISSUER="https://keycloak.example.com/realms/your-realm"

# Optional SMTP settings. Leave all values empty to disable email delivery.
EMAIL_HOST=""
EMAIL_PORT="587"
EMAIL_USER=""
EMAIL_PASS=""
EMAIL_FROM="Special Risk Allowance Workflow <noreply@example.com>"

# Optional browser-push settings. Leave keys empty to disable push delivery.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@example.com"
