# Docker Compose settings. The app binds to this port only on 127.0.0.1.
APP_PORT=3001
IMAGE_TAG=latest

NEXT_PUBLIC_APP_ENV=uat

# Required application settings
DATABASE_URL="postgresql://user:password@postgres.example.com:5432/sraw-uat?schema=public"
NEXTAUTH_URL="https://uat-sraw.example.com"
AUTH_SECRET="replace-with-a-long-random-secret"
AUTH_KEYCLOAK_ID="sraw-uat"
AUTH_KEYCLOAK_SECRET="keycloak-client-secret"
AUTH_KEYCLOAK_ISSUER="https://sso.hrdata.space/realms/thtd"

# Optional SMTP settings. Leave all values empty to disable email delivery.
EMAIL_HOST=""
EMAIL_PORT="587"
EMAIL_USER=""
EMAIL_PASS=""
EMAIL_FROM="Special Risk Allowance Workflow <noreply@example.com>"

# Optional browser-push settings. Leave keys empty to disable push delivery.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@example.com"
