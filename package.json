{
  "name": "special-risk-allowance-workflow",
  "version": "0.1.1",
  "private": true,
  "packageManager": "bun@1.4.0",
  "scripts": {
    "dev": "bun run prepare:pdf && next dev",
    "devh": "bun run prepare:pdf && next dev --experimental-https -H local.sraw.space",
    "build": "bun run prepare:pdf && next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:schema": "prisma migrate diff --from-config-datasource --to-schema prisma/schema.prisma --exit-code",
    "test:migrations": "bun scripts/test-migrations.mjs",
    "prepare:pdf": "node scripts/prepare-pdf-worker.mjs",
    "test:department-db": "node scripts/test-department-db.mjs",
    "test:off-site-work-db": "node scripts/test-off-site-work-db.mjs",
    "test:presence-db": "node scripts/test-presence-db.mjs",
    "test:email-db": "node scripts/test-email-db.mjs",
    "email:worker": "bun scripts/email-worker.ts"
  },
  "dependencies": {
    "@emotion/cache": "11.14.0",
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@hookform/resolvers": "^5.9.1",
    "@mui/material": "7.3.11",
    "@mui/material-nextjs": "7.3.10",
    "@mui/x-charts": "8.29.3",
    "@mui/x-date-pickers": "8.29.3",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@radix-ui/react-avatar": "^1.2.6",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dayjs": "1.11.23",
    "lucide-react": "^1.45.0",
    "motion": "12.43.0",
    "next": "16.3.5",
    "next-auth": "5.0.0-beta.32",
    "next-themes": "^0.4.6",
    "nodemailer": "^9.1.1",
    "pdfjs-dist": "6.2.108",
    "pg": "^8.23.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.88.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "uuidv7": "^1.2.1",
    "web-push": "^3.6.7",
    "zod": "^4.6.2"
